	enc m2_fill areaid.fe -lt 0.50 -output region
	edge_select -inside m2_fill areaid.fe 
	select -cut m2_fill areaid.fe ;
}



////////////////////////////////////////////////////////////////////////////
// met3 fill

// Size
rule m3.fill.1 {
	caption "met3 fill must be rectangles"
	vertex m3_fill -gt 4.0 ;
}
rule m3.fill.2 {
	caption "Min width of met3 fill:  0.5 um"
	rect_chk m3_fill -lt 0.50 ;
}
rule m3.fill.3 {
	caption "Max length of met3 fill:  2. um"
	rect_chk m3_fill -gt 2.0 ; 
}

// Overlap
rule m3.fill.4 {
	caption "met3 fill must not overlap met3"
	select -outside -not m3_fill m3_dg
}
rule m3.fill.5 {
	caption "met3 fill must not overlap areaid:seal"
	select -outside -not m3_fill SEALID
}
rule m3.fill.6 {
	caption "met3 fill must not overlap via2"
	select -outside -not m3_fill via2
}
rule m3.fill.7 {
	caption "met3 fill must not overlap via3"
	select -outside -not m3_fill via3
}
rule m3.fill.8 {
	caption "met3 fill must not overlap met3 fill block"
	select -outside -not m3_fill m3_fillblock
}
// Spacing

rule m3.fill.9 {
	caption "Min spacing met3 fill to met3 fill: 0.3 um"
	exte m3_fill -lt 0.30 -single_point -output region
}
rule m3.fill.10 {
	caption "Min spacing (no touch) met3 fill to areaid.seal (SEALID): 1. um"
	exte m3_fill SEALID -lt 1.0 -output region
	select -touch m3_fill SEALID 
 	select -interact -single_point only m3_fill SEALID ;
}
rule m3.fill.11 {
	caption "Min spacing (no touch) met3 fill to via2: 0.5 um"
	exte m3_fill via2 -lt 0.50 -output region
	select -touch m3_fill via2 ;
}
rule m3.fill.12 {
	caption "Min spacing (no touch) met3 fill to met3 dg: 0.5 um"
	exte m3_fill m3_dg -lt 0.50 -output region
	select -touch m3_fill m3_dg 
	select -interact -single_point only m3_fill m3_dg ;
}
rule m3.fill.13 {
	caption "Min spacing (no touch) met3 fill to via3: 0.5 um"
	exte m3_fill via3 -lt 0.50 -output region
	select -touch m3_fill via3 ;
}
rule m3.fill.14 {
	caption "Min spacing (no touch) met3 fill to met3 fill_block: 0.5 um"
	exte m3_fill m3_fillblock -lt 0.50 -output region
	select -touch m3_fill m3_fillblock 
	select -interact -single_point only m3_fill m3_fillblock ;
}

// Enclosure
rule m3.fill.15 {
	caption "Min enclosure of met3 fill by FRAME (areaid.fe): 0.5 um"
	caption " met3 fill straddling FRAME not allowed "
	enc m3_fill areaid.fe -lt 0.50 -output region
	edge_select -inside m3_fill areaid.fe ;
	select -cut m3_fill areaid.fe ;
}


