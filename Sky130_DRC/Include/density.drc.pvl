// fill rules involving capm & cap2m 
// m3_fill, m4_fill should completely avoid capm
// m4_fill, m5_fill should completely avoid cap2m

rule "m3.fill.capm.1" {
	caption "met3 fill should not overlap or touch capm"
	select -interact -single_point also m3_fill capm ;
}
rule "m3.fill.capm.2" {
	caption "Min space met3 fill to capm: 1.2
	exte capm m3_fill -lt 1.2 -abut -lt 90 -exclude_shielded -output region
}

// repeat for m4 fill to capm ??
// repeat for m4,m5 & cap2m

rule "m4.fill.cap2m.1" {
	caption "met4 fill should not overlap or touch cap2m"
	select -interact -single_point also m4_fill cap2m ;
}
rule "m4.fill.cap2m.2" {
	caption "Min space met4 fill to capm: 1.2
	exte capm m3_fill -lt 1.2 -abut -lt 90 -exclude_shielded -output region
}

