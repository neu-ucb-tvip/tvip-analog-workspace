	exte m5_fill -lt 1.60 -single_point -output region
}
rule m5.fill.9  {
	caption "Min spacing (no touch) met5 fill to areaid.seal (SEALID): 1. um"
	exte m5_fill SEALID -lt 1.0 -output region
	select -touch m5_fill SEALID 
	select -interact -single_point only m5_fill SEALID ;	
