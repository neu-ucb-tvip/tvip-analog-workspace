rule CDR.nsm.1 {
	caption "CDR: Min width of nsm: 3.00 um"
	inte nsm -lt 3.000 -single_point -output region
}

rule CDR.nsm.2 {
	caption "CDR: Min spacing of nsm: 4.00 um"
	exte nsm nsm -lt 4.000 -single_point -output region
}

