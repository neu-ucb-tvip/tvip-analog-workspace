//////////////////////////////////////////////////////////////////
//	 m2 rules			 			//
// Version 0.0_2.12  July 22, 2025				//
// DRM Section 5.7.25			   			//
//////////////////////////////////////////////////////////////////

// v2.10:  m2 fill rules added
// m2_fill removed here since m2 fill rules have larger minimum value:
//   m2_fill minimum width is 0.3 um
//   m2_fill minimum spacing is 0.03 um 
//   enclosure rules are not relevant since m2_fill cannot overlap via1 or via2
//   Also, removing the fill shapes from these checks will speed processing.

rule CDR.m2.1 {
	caption "CDR: Min width of met2: 0.14 um"
	inte m2_dg -lt 0.140 -output region
}


////////////////////////////////////////////////////////////////////////////////////
// Spacing rules:  Huge met2 and regular met2
// 	huge_met2: met2 with width > 3.0
//
// See m1 rules for methodology description
// 
// min spacing (met2 attached to huge_met2) to met2:  0.28
// min spacing HUGE to met2:  0.28
// min spacing met2 to met2:  0.14  

rule CDR.m2.2 {
	caption "CDR: Min spacing/notch of met2: 0.14 um"
	exte m2_dg -lt 0.140 -single_point -output region
}

NOT m2_dg huge_met2 met2_not_huge ;
size huge_met2 -by 0.28  -inside_of m2_dg  -outputlayer huge_met2_028
AND met2_not_huge huge_met2_028 met2_huge_and ;
select -touch met2_huge_and huge_met2 -outputlayer met2_touching_huge

rule CDRW.m2.3a {
	caption "CDRW: Min spacing of huge met2 (width > 3.0 um) to narrow met2,"
	caption "including features extending 0.28 um into narrow met2: 0.28 um"
	exte met2_touching_huge m2_dg -lt 0.280 -single_point -output region
}

rule CDRW.m2.3b {
	caption "CDRW: Min spacing of huge_met2 to met2 excluding features checked by m2.3a: 0.28 um"
	exte huge_met2 m2_dg -lt 0.280 -single_point -output region
}

////////////////////////////////////////////////////////////////////////////////////


// Rule is obsolete and removed
//rule m2.3c {
//	caption "Min spacing between floating_met2 with AR_met2_A: 0.05 and AR_met2_B: 0.032"
//	caption "outside areaid.sc must be greater than: 0.145 um"
//}


#IFNDEF CU
   rule CDR.m2.4a {
	caption "CDR: via1 outside areaid.ce must be enclosed by met2 by at least: 0.055 um"
	enc (NOT via1 areaid.ce) m2_dg -lt 0.055 -output region
	edge_select (NOT via1 areaid.ce) m2_dg ;  // finds 0.0 enc
   }
   rule CDR.m2.4b {
	caption "CDR: via1 inside areaid.ce must be enclosed by met2 by at least: 0.045 um"
	enc (AND via1 areaid.ce) met2 -lt 0.045 -output region
	edge_select (AND via1 areaid.ce) m2_dg ;  // finds 0.0 enc
   }

   rule CDR.m2.5 {
	caption "CDR: via1 outside areaid.ce must be enclosed by met2 on one of two adjacent sides by at least: 0.085 um" 
	rect_enc (NOT via1 areaid.ce) m2_dg -good 0.085 0.000 0.085 0.000
   }
#ENDIF  // ifndef CU

rule CDR.m2.6 {
	caption "CDR: min met2 area: 0.067 sq um"
	area m2_dg -lt 0.067
}

rule CDR.m2.7 {
	caption "CDR: min area of met2 holes: 0.140 sq um"
	holes m2_dg -outputlayer m2.7_a
	area m2.7_a -lt 0.140
}


// NOTE:  rule m2.pd.1 moved to density file and renamed m2.local.min


// rules m2.13, m2.14, m2.14a -- SEE BELOW

#IFDEF CU
	rule m2.11 {
	caption "Cu Flow - Max width of met2: 4.00 um"
	with_width m2_dg -gt 4.000
	}

	rule m2.12 {
	  caption "Cu Flow - Add slots and remove vias and contacts if met2 wider than > 3.200"
	  with_width m2_dg -gt 3.200 ;
	}

	rule m2.15 {
	caption "Cu Flow - via1 must be enclosed by met2 on one of two adjacent sides by at least: 0.04 um" 
	rect_enc via1 m2_dg -good 0.040 0.000 0.040 0.000
	}

// CU met2 Density

// rules m2.13, m2.14, m2.14a 
//	 "Max pattern density (PD) of met2: 0.77"
//	 "met2 PD window size == 50.0 um"
//	 "met2 PD window step == 25.0 um"

// These rules specify "met2" and not met2 oxide, so do not use the sized met2 

  rule m2.13 {
 	caption "m2.13: Max pattern density (PD) of met2 (CU): 0.77"
	caption "m2.14: met2 PD window size 5 um"
	caption "m2.14a: met2 PD window step 25 um"
	caption "  rdb file:  m2.13.rdb"
	density met2 -gt 0.77 -window 50 -step 25  -rdb "m2.13.rdb"
  }
#ENDIF  // ifndef CU


// *****************************************************************************************
// met2 Recommended Chip-Level Density rules - OBSOLETE and removed

//  Algorithm should flag errors, for met2, if ANY of the following is true:
//  An entire 700x700 window is covered by cmm2 waffleDrop, and met2 < 70% for same window 
//  80-100% of 700x700 window is covered by cmm2 waffleDrop, and met2 < 65% for same window 
//  60-80% of 700x700 window is covered by cmm2 waffleDrop, and met2 < 60% for same window 
//  50-60% of 700x700 window is covered by cmm2 waffleDrop, and met2 < 50% for same window
//  40-60% of 700x700 window is covered by cmm2 waffleDrop, and met2 < 40% for same window
//  30-40% of 700x700 window is covered by cmm2 waffleDrop, and met2 < 30% for same window
//  Exclude cells whose are is below 40Kum**2.
//  NOTE: Required for IP, Recommended for Chip-level.
// *****************************************************************************************
