//////////////////////////////////////////////////////////////////
// Fill shapes

// 1281  diff	fill	65	  99
// 1282  poly	fill	66	  99
// 1283  li1	fill	67	  99
// 1284  m1	fill	68	  99
// 1285  m2	fill	69	  99
// 1286  m3	fill	70	  99
// 1287  m4	fill	71	  99
// 1288  m5	fill	72	  99

layer_def diff_fill		1281
layer_map 65 -datatype     99	1281	//diff,fill,65:99
layer_def poly_fill	     	1282
layer_map 66 -datatype     99	1282	//poly,fill,66:99
layer_def li_fill	     	1283
layer_map 67 -datatype     99	1283	//li,fill,67:99

layer_def m1_fill	     	1284
layer_map 68 -datatype     99	1284	//m1,fill,68:99
layer_def m2_fill	     	1285
layer_map 69 -datatype     99	1285	//m2,fill,69:99
layer_def m3_fill	     	1286
layer_map 70 -datatype     99	1286	//m3,fill,70:99
layer_def m4_fill	     	1287
layer_map 71 -datatype     99	1287	//m4,fill,71:99
layer_def m5_fill	     	1288
layer_map 72 -datatype     99	1288	//m5,fill,72:99

// Add fill shapes to drawing layers

OR diff_dg diff_fill diff ;
OR poly_dg poly_fill poly ;
OR li1_dg  li_fill   li1  ;
OR m1_dg m1_fill m1 ;
OR m2_dg m2_fill m2 ;
OR m3_dg m3_fill m3 ;
OR m4_dg m4_fill m4 ;
OR m5_dg m5_fill m5 ;
 
//////////////////////////////////////////////////////////////////

layer_def diff_fill_block 	1311
layer_map 65 -datatype   98	1311
layer_def poly_fill_block 	1312
layer_map 66 -datatype   98	1312
layer_def li_fill_block 	1313
layer_map 67 -datatype   98	1313

layer_def m1_fill_block 	1301
layer_map 68 -datatype   98	1301
layer_def m2_fill_block 	1302
layer_map 69 -datatype   98	1302
layer_def m3_fill_block 	1303
layer_map 70 -datatype   98	1303
layer_def m4_fill_block 	1304
layer_map 71 -datatype   98	1304
layer_def m5_fill_block 	1305
layer_map 72 -datatype   98	1305

layer_def fillWindow	 	1305	// areaid fillWindow
layer_map 81 -datatype   13	1305


//////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////

// Layers

extent_drawn -original -outputlayer ALL

// areaid fillWindow    GDS 81:13


// if fillWindow is empty, fill_area is ALL
//  select -enclose -not ALL fillWindow -outputlayer ALL_emptyFillWindow
//  OR fillWindow ALL_emptyFillWindow -outputlayer fill_area

 
  NOT ALL SEALID -outputlayer ALL_not_sealid

  // If SEALID is missing, "holes SEALID" is empty
  // If sealid_hole is empty, fill_area is ALL

  holes SEALID sealid_hole
  select -enclose -not ALL sealid_hole -outputlayer ALL_outside_sealid

  OR sealid_hole ALL_outside_sealid -outputlayer fill_area
    

// KO areas used by several layers

size -by 1.0 SEALID -outputlayer KO_all_1
edge_expand -inside_by 0.50 -corner_fill areaid.ft -outputlayer KO_all_2

size -by 0.005 licon -outputlayer licon_KO
size -by 0.005 mcon -outputlayer mcon_KO

// OR KO_all_1 KO_all_2 LI_KO_1 (size -by 0.005 poly) -outputlayer LI_KO

// this is needed in several locations

OR hvi vhvi uhvi -outputlayer HV_all  ;

//////////////////////////////////////////////////////////////////

// ** Min spacing of poly fill to diff fill < 0.30 **

//////////////////////////////////////////////////////////////////
// POLY

// Code for poly to create poly fill regions
// poly & diff filled with fill cell in DIFF section

// Low stepped density:   8%	(700 square micron window stepped at 70)
// high stepped density: 38%  	(700 square micron window stepped at 70)

// poly "pattern density RANGE" inside seal ring --
//	2000 um square window stepped 200 um:	max 15%
//       700 um square window stepped 70 um: 	max 30 %

// poly_fill is 0.48 (min) x 0.72 (max)

// keepout layers and min spacing
//  	fill_block	1.0, no overlap
//	SEALID: 	1.0, no overlap		KO_all_1
//	diff_fill: 	0.3, no overlap
//	diff_dg:  	1.0, no overlap
//	poly:		1.0, no overlap
//	poly_fill:	0.36, no overlap

// poly fill no overlap with licon

// min enclosures
//	areaid:frame	0.50			KO_all_2

// Other
//	overlap with LI, LI fill seems OK
// 	poly block	doesn't seem to exist

density poly -lt 0.08 -window 700 -inside_of layer fill_area -outputlayer poly_fill_regions

size -by 1.0  (OR diff_dg tap_dg poly_dg poly_fill_block) -outputlayer poly_KO_1
size -by 0.3  diff_fill  -outputlayer poly_KO_2

size -by 0.36 poly_fill -outputlayer poly_KO_3

OR KO_all_1 KO_all_2 poly_KO_1 poly_KO_2 poly_KO_3 -outputlayer poly_KO


// going to fill poly & diff at the same time since poly fill & diff fill cannot overlap


//////////////////////////////////////////////////////////////////
// DIFF

// Low stepped density : 28%  (700 um window stepped 70 um)
// High stepped density: 62%  (700 um window stepped 70 um)

// diff "pattern density RANGE" --
// 	 700 um window stepped 70 um:  max 30 %
//	2000 um window stepped 200 um: max 15 %

// diff is:  OR m1:dg  m1:fill

// diff_fill is 0.5 (min) x 25.0 (max)

// keepout layers and min spacing
//	SEALID: 	1.0			KO_all_1
//	diff_dg:  	0.5	** also consider tap !! **
//  	fill_block	0.5, no overlap
//	poly_dg:	0.5	NO overlap
//	diff_fill: 	0.4
//	licon: 		no overlap or butting
//	poly_fill:	0.3	NO overlap

// other min spacings	   
//	nsdm			0.13	overlap is OK 
//	psdm			0.13	overlap is OK 
//	nwell			0.34  	overlap is OK
//	hvnwell (5v,12v,20v)  	0.33	overlap is OK
//	hvi, vhvi, uhvi 	0.18	overlap is OK	

// min enclosures
//	areaid:frame		0.50			KO_all_2
//	nwell			0.18  
//	hvnwell (5v,12v,20v) 	0.43	
//	hvi (v5)	 	0.18	overlap is OK	
//	  this last ENC rule appears to apply only to v5

// Other
//      ** diff fill cannot straddle hvi (5v) **
//	overlap with LI, LI fill seems OK

size -by 0.5  (OR diff_dg tap_dg diff_fill_block poly_dg) -outputlayer diff_KO_1
size -by 0.3  poly_fill -outputlayer diff_KO_2
size -by 0.4  diff_fill -outputlayer diff_KO_3

// note that diff fill can be *completely* inside nsdm / psdm
// 	but no straddling or touching
// exclude these regions since we are using diff-poly fill cell
// (cannot control if shapes in the fill cell straddle the nsdm / psdm border)
// (the nsdm/psdm region inside standard cells too narrow for the fill cell anyway)
// 
// fill with diff and poly separately inside nsdm / psdm

size -by 0.13 (OR nsdm psdm) diff_KO_4

// nwell and hvnwell (5v,12v,20v)

AND nwell HV_all  -outputlayer hvnwell
NOT nwell hvnwell -outputlayer lvnwell

//edge_expand -inside_by 1.0 areaid.ft -outputlayer m5_KO_3
//   note that we need to use "-corner_fill" to fill space near corners
//   otherwise fill shapes will be placed to close to nwell corners.

// Just going to use 0.34 spacing to handle all nwell
// Also, *some* DRC decks use 0.34 spacing for diff fill to nwell 
//	(LV vs. HV nwell not considered)

// ----------------------------------------------------------------------------
// SW deck has several diff to HV nwell spacing minimums of 0.43 um
// while I believe these checks should not apply to diff_fill, violations are found.
// So, adding 0.43 for outside edge_expand for all HV nwell

// Use nwell for the smaller values to avoid weird regions if nwell not completely enclosed by HV

edge_expand -outside_by 0.34 -corner_fill nwell   -outputlayer lvnwell_outside
edge_expand -outside_by 0.43 -corner_fill hvnwell -outputlayer hvnwell_outside
OR lvnwell_outside hvnwell_outside -outputlayer nwell_outside

edge_expand -inside_by  0.18 -corner_fill nwell   -outputlayer lvnwell_inside
edge_expand -inside_by  0.43 -corner_fill hvnwell -outputlayer hvnwell_inside
OR lvnwell_inside hvnwell_inside -outputlayer nwell_inside

OR hvnwell_inside lvnwell_inside nwell_outside -outputlayer diff_KO_5
// ----------------------------------------------------------------------------

// diff_fill space to HV: 0.18  &  diff_fill enc by HV: 018
// v05d update: Using 0.20 for both to keep diff_fill 0.4 um apart

// HV_all is just the HV marker layers (does not include nwell)
edge_expand -outside_by 0.20 -corner_fill HV_all -outputlayer HV_all_outside
edge_expand -inside_by  0.20 -corner_fill HV_all -outputlayer HV_all_inside


OR HV_all_outside  HV_all_inside  -outputlayer diff_KO_6

OR KO_all_1 KO_all_2 diff_KO_1 diff_KO_2 diff_KO_3 diff_KO_4 diff_KO_5 diff_KO_6 licon_KO -outputlayer diff_KO

NOT fill_area (OR diff_KO poly_KO) -outputlayer diff_poly_fill_area


// v08  3 new FILLCELLs
//  width 25.0 length 2.5 // width 10.0 length 2.5  // width 3.0 length 2.5
//rect_gen -width 2.96 -length 3.02 -spacing 0.4  -offset  0 -inside_of layer diff_poly_fill_area -outputlayer diff_poly_fillgen_0

// still do this: remove fill shapes that straddle vhi (v5)

CMACRO GEN_DIFF  diff_poly_fill_area  diff_poly_fillgen_25i  25.0  2.5  diff_poly_fill_area_25
select -cut -not diff_poly_fillgen_25i hvi -outputlayer diff_poly_fillgen_25

CMACRO GEN_DIFF  diff_poly_fill_area_25  diff_poly_fillgen_10i  10.0  2.5  diff_poly_fill_area_10
select -cut -not diff_poly_fillgen_10i hvi -outputlayer diff_poly_fillgen_10

CMACRO GEN_DIFF  diff_poly_fill_area_10  diff_poly_fillgen_3i  3.0  2.5  diff_poly_fill_area_3
select -cut -not diff_poly_fillgen_3i hvi -outputlayer diff_poly_fillgen_3

OR diff_poly_fillgen_3 diff_poly_fillgen_10 diff_poly_fillgen_25 -outputlayer diff_poly_fillgen

// still make  "diff_poly_fillgen"  as it's needed for KO
//   ...but the other 3 are the outputs now...

//rule diff_poly_fillgen    { copy diff_poly_fillgen ; }
rule diff_poly_fillgen_3  { copy diff_poly_fillgen_3 ; }
rule diff_poly_fillgen_10 { copy diff_poly_fillgen_10 ; }
rule diff_poly_fillgen_25 { copy diff_poly_fillgen_25 ; }

//////////////////////////////////////////////////////////////////
// diff & poly separate fills

// make different diff KO for nsdm / psdm 


// ----------------------------------------------------------------------------
// issue with nsdm / psdm is that the minimum enclosure is 0, and,
// the minimum spacing to nsdm / psdm is less than the diff_fill spacing of 0.4
// so diff_fill in nearby fill areas could be too close
// to solve this, I simply use 0.4 for the edge_expand

// note that rules for nsdm/psdm enclosure of diff should exclude diff_fill

//edge_expand -outside_by 0.40 -corner_fill nsdm -outputlayer nsdm_p4
//edge_expand -outside_by 0.40 -corner_fill psdm -outputlayer psdm_p4

//OR nsdm_p4 psdm_p4 -outputlayer diff_KO_4_pass2

// v06 update:
// this sizing by 0.40 is limiting the size of diff fill at the nsdm/psdm border,
//   because the outside size of each one overlaps the other one
// instead, I'm going to outside size 0.4 the (OR nsdm psdm)
// to make sure diff fill is not too close to the edge of the *other* region,
//   still inside size by 0.13

edge_expand -inside_by 0.13 -corner_fill nsdm -outputlayer nsdm_p13
edge_expand -inside_by 0.13 -corner_fill psdm -outputlayer psdm_p13

edge_expand -outside_by 0.40 -corner_fill (OR nsdm psdm) -outputlayer nsdm_psdm_p4

OR nsdm_psdm_p4 nsdm_p13 psdm_p13  -outputlayer diff_KO_4_pass2

// ----------------------------------------------------------------------------

// created diff_poly areas need to be part of KO:

size -by 0.4 diff_poly_fillgen -outputlayer pass2_KO

OR KO_all_1 KO_all_2 diff_KO_1 diff_KO_2 diff_KO_3 diff_KO_4_pass2 diff_KO_5 diff_KO_6 licon_KO -outputlayer diff_KO_pass2

NOT fill_area (OR pass2_KO diff_KO_pass2) -outputlayer diff_fill_area_pass2


// ----------------------------------------------------------------------------
// remove diff_fillgen straddling COREID to avoid false DRCs
//select -cut -not diff_fillgen_0 areaid.ce -outputlayer diff_fillgen
// ----------------------------------------------------------------------------


// /////////////////////////////////////////////////////////////////////
// POLY fill, 2nd pass (after FILLCELLS)

// need to use the 2nd pass generate diff fill in the poly KO

// poly fill to diff fill spacing:  0.3 min

// but poly_fill to poly_fill min spacing is 0.36
// KO generated from diff_fill using 0.3 size may not be big enough -
//   poly_fill near the corners of KO areas could be < 0.36 um (it happened)
// therefore, for this KO use 0.36
//OR poly_KO (size -by 0.3 diff_fillgen) -outputlayer poly_KO_pass2

OR poly_KO (size -by 0.36 diff_fillgen) -outputlayer poly_KO_pass2

NOT fill_area (OR pass2_KO poly_KO_pass2) -outputlayer poly_fill_area_pass2

// poly_fill is 0.48 (min) x 0.72 (max)


CMACRO GEN_POLY  poly_fill_area_pass2 poly_fillgen_72   0.72 0.72  poly_fill_area_pass3
CMACRO GEN_POLY  poly_fill_area_pass3 poly_fillgen_48   0.48 0.48  poly_fill_area_pass4
CMACRO GEN_POLY  poly_fill_area_pass4 poly_fillgen_48_2 0.48 0.48  poly_fill_area_pass5

//rect_gen -width 0.72 -length 0.72 -spacing 0.36  -offset  0 0 -inside_of layer poly_fill_area_pass2 -outputlayer poly_fillgen_72
//size -by 0.36 poly_fillgen_72 -outputlayer poly_fillgen_72_sized
//NOT poly_fill_area_pass2 poly_fillgen_72_sized poly_fill_area_pass3
//rect_gen -width 0.48 -length 0.48 -spacing 0.36  -offset  0 0 -inside_of layer poly_fill_area_pass3 -outputlayer poly_fillgen_48

// Generate a few more directly from the last REGION
// Manual seems inaccurate:  -centers 0.02 gives square at center 0.02 um x 0.02 um
//   "-centers 2" does NOT give 2 dbu size square

size -by 0.24 poly_fill_area_pass5 -underover -outputlayer poly_fill_underover
bbox poly_fill_underover -centers 0.02   -outputlayer  poly_bbox_c02

size -by 0.23 poly_bbox_c02 -inside_of poly_fill_underover -outputlayer poly_fill_maybe
rect_chk poly_fill_maybe -ge 0.48 -by -ge 0.48 -outputlayer poly_fill_bbox 

OR poly_fillgen_72 poly_fillgen_48 poly_fillgen_48_2 poly_fill_bbox -outputlayer poly_fillgen_0 ;

// find poly fill shapes are too close; can happen in nearby corners of separate fill regions
select -with_neighbor -not poly_fillgen_0 -ge 1 -space -lt 0.36 -outputlayer poly_fillgen

rule poly_fillgen { copy poly_fillgen ; }

// /////////////////////////////////////////////////////////////////////
// MACRO takes REGION, generates diff FILL, makes NEW_REGION (NOT sized FILL)
// region fill_output new_region width length spacing offset
// using KO not as a passed variable is OK as it's internal to MACROs 
 
DMACRO GEN_POLY  REGION  FILL  W L  NEW_REGION {
  rect_gen -width W -length L -spacing 0.36 -offset 0.0 -inside_of layer REGION -maintain_spacing -outputlayer FILL
  size -by 0.36 FILL -outputlayer KO
  NOT REGION KO -outputlayer NEW_REGION
}
// /////////////////////////////////////////////////////////////////////



//////////////////////////////////////////////////////////////////
//v07 generate diff_fillgen_alt in nsdm/psdm areas directly

size -by 0.5  poly_dg   -outputlayer polyd
size -by 0.3  poly_fill -outputlayer polyg
size -by 0.34 nwell     -outputlayer nws
size -by 0.4  diff_fill -outputlayer difff
size -by 0.5 (OR diff_dg tap_dg) -outputlayer diffg

// these first ones are inside nsdm ; these will be outside nwell
OR polyd polyg nws difff diffg -outputlayer diff_size_1

edge_expand -inside_by 1.0 nsdm -outputlayer nsdm_edge_0
edge_expand -inside_by 1.0 psdm -outputlayer psdm_edge_0

size -by 0.495 -underover nsdm_edge_0 -outputlayer nsdm_edge
size -by 0.495 -underover psdm_edge_0 -outputlayer psdm_edge

//NOT nsdm diff_size_1 -outputlayer diff_region_1i
NOT nsdm_edge diff_size_1 -outputlayer diff_region_1i
size -by 0.25 -underover diff_region_1i -outputlayer diff_region_1
// v07b 
size -by 0.155 m1_dg -outputlayer m1_dg_si
NOT diff_region_1i m1_dg_si -outputlayer diff_fillgen_alt1_i
select -inside diff_fillgen_alt1_i nsdm -outputlayer diff_fillgen_alt1_i2

// since we didn't use rect_gen, make sure these shapes are rectangles at least 0.5 x 0.5:
rect_chk diff_fillgen_alt1_i2 -ge 0.5 -by -ge 0.5 -outputlayer diff_fillgen_alt1	// ****************************

// these first ones are inside psdm ; these will usually be inside nwell
// NOT the outside edges of nwell (nwe2) in case some are formed outside nwell (it happened)
// note also, diff fill must be enclosed by HV (5v) nwell by 0.43 um (use nwe3)

edge_expand -inside_by 0.18  -corner_fill nwell -outputlayer nwe1
edge_expand -outside_by 0.34 -corner_fill nwell -outputlayer nwe2
edge_expand -inside_by 0.43  -corner_fill (AND nwell hvi) -outputlayer nwe3

OR polyd polyg nwe1 nwe2 nwe3 difff diffg -outputlayer diff_size_2

//NOT psdm diff_size_2 -outputlayer diff_region_2i
NOT psdm_edge diff_size_2 -outputlayer diff_region_2i
size -by 0.25 -underover diff_region_2i -outputlayer diff_region_2
// v07b  ... already have m1_dg_si 
//size -by 0.155 m1_dg -outputlayer m1_dg_si
NOT diff_region_2i m1_dg_si -outputlayer diff_fillgen_alt2_i
select -inside diff_fillgen_alt2_i psdm -outputlayer diff_fillgen_alt2_i2

// some of these are too close to nsdm; use: nsdm_out13
NOT diff_fillgen_alt2_i2 nsdm_out13 -outputlayer diff_fillgen_alt2_i3

// since we didn't use rect_gen, make sure these shapes are rectangles at least 0.5 x 0.5:
rect_chk diff_fillgen_alt2_i3 -ge 0.5 -by -ge 0.5 -outputlayer diff_fillgen_alt2	// ****************************


/////////////
//rect_gen -width 0.5 -length 0.5 -spacing 0.4  -offset 0 -inside_of layer diff_region_1 diff_fill_area_pass2 -maintain_spacing  -outputlayer diff_fillgen_alt1
//rect_gen -width 0.5 -length 0.5 -spacing 0.4  -offset 0 -inside_of layer diff_region_2 -maintain_spacing  -outputlayer diff_fillgen_alt2


// v07b:  fill spaces NOT filled by diff_fillgen_alt1 & diff_fillgen_alt2
// Area to fill is:  diff_fill_area_pass2  ...but with new diff fill removed
//   (diff_fill_area_pass2 already has FILLCELL removed)
// If this works, update to add larger shapes !!   				*************

// v07c:  use larger shapes
//    4.08x2.0   4.8x1.0    2.5x2.0     2.5x1.0 1.0x0.5   0.5x1.0   0.5x0.5
//  FILLLCELL is ~ 3.0 x 3.0 so it seems unlikely 4.08x2.0 will fit anywhere	

size -by 0.4 (OR diff_fillgen_alt1 diff_fillgen_alt2) -outputlayer diff_alt_KO


// v07c:  need to maintain spacing to nsdm / psdm, but overlap is OK
edge_expand -outside_by 0.13 -corner_fill nsdm -outputlayer nsdm_out13
edge_expand -outside_by 0.13 -corner_fill psdm -outputlayer psdm_out13
//NOT diff_fill_area_pass2 diff_alt_KO -outputlayer diff_region_3rd_pass
NOT diff_fill_area_pass2 (OR diff_alt_KO nsdm_out13 psdm_out13) -outputlayer diff_region_3rd_pass


// /////////////////////////////////////////////////////////////////////
// MACRO takes REGION, generates diff FILL, makes NEW_REGION (NOT sized FILL)
// region fill_output new_region width length spacing offset
// I *think* using KO not as a passed variable is OK as it's internal to MACROs 
 
DMACRO GEN_DIFF  REGION FILL  W L  NEW_REGION {
  rect_gen -width W -length L -spacing 0.4 -offset 0.0 -inside_of layer REGION -maintain_spacing -outputlayer FILL
  size -by 0.4 FILL -outputlayer KO
  NOT REGION KO -outputlayer NEW_REGION
}
// /////////////////////////////////////////////////////////////////////


// 2nd argument is the CREATED FILL
// 3rd argument is the REGION FOR THE NEXT GEN

// WIDTH (horizontal) is the FIRST NUMBER
// HEIGHT (vertical)  is the 2ND NUMBER

// STILL need to OR together all the gen FILL layers
// smallest FILLCELL is  X=3 Y=2.5  so no need to fill with both values larger

// PUT IN some 2nd pass of same sizes for smaller values !!
// END output should be diff_fillgen_alt3

CMACRO GEN_DIFF diff_region_3rd_pass    diff_fillgen_alt3_1a  25.0 2.0  diff_region_3rd_pass_2a
CMACRO GEN_DIFF diff_region_3rd_pass_2a diff_fillgen_alt3_1b  15.0 2.0  diff_region_3rd_pass_2b
CMACRO GEN_DIFF diff_region_3rd_pass_2b diff_fillgen_alt3_1c   5.0 2.0  diff_region_3rd_pass_2c
CMACRO GEN_DIFF diff_region_3rd_pass_2c diff_fillgen_alt3_1d   2.5 2.0  diff_region_3rd_pass_2d
CMACRO GEN_DIFF diff_region_3rd_pass_2d diff_fillgen_alt3_1e   1.5 2.0  diff_region_3rd_pass_2e
CMACRO GEN_DIFF diff_region_3rd_pass_2e diff_fillgen_alt3_1f   1.0 2.0  diff_region_3rd_pass_2f
CMACRO GEN_DIFF diff_region_3rd_pass_2f diff_fillgen_alt3_1g  0.75 2.0  diff_region_3rd_pass_2g
CMACRO GEN_DIFF diff_region_3rd_pass_2g diff_fillgen_alt3_1h   0.5 2.0  diff_region_3rd_pass_2h

OR diff_fillgen_alt3_1a diff_fillgen_alt3_1b diff_fillgen_alt3_1c diff_fillgen_alt3_1d 
   diff_fillgen_alt3_1e diff_fillgen_alt3_1f diff_fillgen_alt3_1g diff_fillgen_alt3_1h
  -outputlayer diff_fillgen_alt3_1
    
CMACRO GEN_DIFF diff_region_3rd_pass_2h diff_fillgen_alt3_2a  25.0 1.5  diff_region_3rd_pass_3a
CMACRO GEN_DIFF diff_region_3rd_pass_3a diff_fillgen_alt3_2b  15.0 1.5  diff_region_3rd_pass_3b
CMACRO GEN_DIFF diff_region_3rd_pass_3b diff_fillgen_alt3_2c   5.0 1.5  diff_region_3rd_pass_3c
CMACRO GEN_DIFF diff_region_3rd_pass_3c diff_fillgen_alt3_2d   2.5 1.5  diff_region_3rd_pass_3d
CMACRO GEN_DIFF diff_region_3rd_pass_3d diff_fillgen_alt3_2e   1.5 1.5  diff_region_3rd_pass_3e
CMACRO GEN_DIFF diff_region_3rd_pass_3e diff_fillgen_alt3_2f   1.0 1.5  diff_region_3rd_pass_3f
CMACRO GEN_DIFF diff_region_3rd_pass_3f diff_fillgen_alt3_2g  0.75 1.5  diff_region_3rd_pass_3g
CMACRO GEN_DIFF diff_region_3rd_pass_3g diff_fillgen_alt3_2h   0.5 1.5  diff_region_3rd_pass_3h

OR diff_fillgen_alt3_2a diff_fillgen_alt3_2b diff_fillgen_alt3_2c diff_fillgen_alt3_2d 
   diff_fillgen_alt3_2e diff_fillgen_alt3_2f diff_fillgen_alt3_2g diff_fillgen_alt3_2h
  -outputlayer diff_fillgen_alt3_2

CMACRO GEN_DIFF diff_region_3rd_pass_3h diff_fillgen_alt3_3a  25.0 1.0  diff_region_3rd_pass_4a
CMACRO GEN_DIFF diff_region_3rd_pass_4a diff_fillgen_alt3_3b  15.0 1.0  diff_region_3rd_pass_4b
CMACRO GEN_DIFF diff_region_3rd_pass_4b diff_fillgen_alt3_3c   5.0 1.0  diff_region_3rd_pass_4c
CMACRO GEN_DIFF diff_region_3rd_pass_4c diff_fillgen_alt3_3d   2.5 1.0  diff_region_3rd_pass_4d
CMACRO GEN_DIFF diff_region_3rd_pass_4d diff_fillgen_alt3_3e   1.5 1.0  diff_region_3rd_pass_4e
CMACRO GEN_DIFF diff_region_3rd_pass_4e diff_fillgen_alt3_3f   1.0 1.0  diff_region_3rd_pass_4f
CMACRO GEN_DIFF diff_region_3rd_pass_4f diff_fillgen_alt3_3g  0.75 1.0  diff_region_3rd_pass_4g
CMACRO GEN_DIFF diff_region_3rd_pass_4g diff_fillgen_alt3_3h   0.5 1.0  diff_region_3rd_pass_4h

OR diff_fillgen_alt3_3a diff_fillgen_alt3_3b diff_fillgen_alt3_3c diff_fillgen_alt3_3d 
   diff_fillgen_alt3_3e diff_fillgen_alt3_3f diff_fillgen_alt3_3g diff_fillgen_alt3_3h
  -outputlayer diff_fillgen_alt3_3

CMACRO GEN_DIFF diff_region_3rd_pass_4h diff_fillgen_alt3_4a  25.0 0.75  diff_region_3rd_pass_5a
CMACRO GEN_DIFF diff_region_3rd_pass_5a diff_fillgen_alt3_4b  15.0 0.75  diff_region_3rd_pass_5b
CMACRO GEN_DIFF diff_region_3rd_pass_5b diff_fillgen_alt3_4c   5.0 0.75  diff_region_3rd_pass_5c
CMACRO GEN_DIFF diff_region_3rd_pass_5c diff_fillgen_alt3_4d   2.5 0.75  diff_region_3rd_pass_5d
CMACRO GEN_DIFF diff_region_3rd_pass_5d diff_fillgen_alt3_4e   1.5 0.75  diff_region_3rd_pass_5e
CMACRO GEN_DIFF diff_region_3rd_pass_5e diff_fillgen_alt3_4f   1.0 0.75  diff_region_3rd_pass_5f
CMACRO GEN_DIFF diff_region_3rd_pass_5f diff_fillgen_alt3_4g  0.75 0.75  diff_region_3rd_pass_5g
CMACRO GEN_DIFF diff_region_3rd_pass_5g diff_fillgen_alt3_4h   0.5 0.75  diff_region_3rd_pass_5h

OR diff_fillgen_alt3_4a diff_fillgen_alt3_4b diff_fillgen_alt3_4c diff_fillgen_alt3_4d 
   diff_fillgen_alt3_4e diff_fillgen_alt3_4f diff_fillgen_alt3_4g diff_fillgen_alt3_4h
  -outputlayer diff_fillgen_alt3_4

CMACRO GEN_DIFF diff_region_3rd_pass_5h diff_fillgen_alt3_5a  25.0 0.5  diff_region_3rd_pass_6a
CMACRO GEN_DIFF diff_region_3rd_pass_6a diff_fillgen_alt3_5b  15.0 0.5  diff_region_3rd_pass_6b
CMACRO GEN_DIFF diff_region_3rd_pass_6b diff_fillgen_alt3_5c   5.0 0.5  diff_region_3rd_pass_6c
CMACRO GEN_DIFF diff_region_3rd_pass_6c diff_fillgen_alt3_5d   2.5 0.5  diff_region_3rd_pass_6d
CMACRO GEN_DIFF diff_region_3rd_pass_6d diff_fillgen_alt3_5e   1.5 0.5  diff_region_3rd_pass_6e
CMACRO GEN_DIFF diff_region_3rd_pass_6e diff_fillgen_alt3_5f   1.0 0.5  diff_region_3rd_pass_6f
CMACRO GEN_DIFF diff_region_3rd_pass_6f diff_fillgen_alt3_5g  0.75 0.5  diff_region_3rd_pass_6g
CMACRO GEN_DIFF diff_region_3rd_pass_6g diff_fillgen_alt3_5h   0.5 0.5  diff_region_3rd_pass_6h

// extra pass of the last one

CMACRO GEN_DIFF diff_region_3rd_pass_6h diff_fillgen_alt3_5i   0.5 0.5  diff_region_3rd_pass_6i


///////////////////////////////////////////////////////////////////////////////////////////////////////////////


OR diff_fillgen_alt3_5a diff_fillgen_alt3_5b diff_fillgen_alt3_5c diff_fillgen_alt3_5d 
   diff_fillgen_alt3_5e diff_fillgen_alt3_5f diff_fillgen_alt3_5g diff_fillgen_alt3_5h diff_fillgen_alt3_5i
  -outputlayer diff_fillgen_alt3_5

OR diff_fillgen_alt3_1 diff_fillgen_alt3_2 diff_fillgen_alt3_3 diff_fillgen_alt3_4 diff_fillgen_alt3_5  -outputlayer diff_fillgen_alt3

// this is our new diff_fillgen !!
//OR diff_fillgen_alt1 diff_fillgen_alt2 diff_fillgen_alt3 -outputlayer diff_fillgen
OR diff_fillgen_alt1 diff_fillgen_alt2 diff_fillgen_alt3 -outputlayer diff_fillgen_01

// make the following corrections:
//   remove diff fill straddling COREID
//   remove diff fill shapes that are too close; can happen in nearby separate fill regions 

select -cut -not diff_fillgen_01 areaid.ce -outputlayer diff_fillgen_02

// find diff fill shapes that are too close; can happen in nearby separate fill regions
select -with_neighbor diff_fillgen_02 -ge 1 -space -lt 0.40 -outputlayer diff_fillgen_too_close
size -by -0.2 diff_fillgen_too_close -outputlayer diff_fillgen_too_close_sized
rect_chk diff_fillgen_too_close_sized -ge 0.5 -by -ge 0.5 -outputlayer diff_fillgen_keep 

NOT diff_fillgen_02 diff_fillgen_too_close -outputlayer diff_fillgen_03
OR diff_fillgen_03 diff_fillgen_keep -outputlayer diff_fillgen
 

rule diff_fillgen { copy diff_fillgen ; }


//////////////////////////////////////////////////////////////////



//////////////////////////////////////////////////////////////////
// LI

// LI min global density (inside seal ring): 33 %
// LI max global density (inside seal ring): 62 %

// 	there are no stepped density rules for LI

// li_fill is 0.50 (min) x 5.0 (max)

// No Overlap:
//   	areaid:seal / licon / mcon / LI dg / LI fill / LI fill_block / LI block / poly dg
//	LI fill overlap with diff dg / diff fill / poly fill 	OK
// Min Spacings:  0.50
//   	li_fill / licon / LI / mcon / LI fill_block: 	0.50 
//      LI block 					0.17 
// 	SEALID:  					1.0  
// Min Enclosure of li_fill by areaid.ft:  		0.50

size -by 0.50 (OR li1 licon mcon li_fill_block) -outputlayer LI_KO_1
size -by 0.17 li_block -outputlayer LI_KO_2

OR KO_all_1 KO_all_2 LI_KO_1 LI_KO_2 licon_KO mcon_KO (size -by 0.005 poly)  -outputlayer LI_KO

NOT fill_area LI_KO -outputlayer LI_fill_area

// 0.6 x 0.6 space 0.75 gave 25.8%
// 1.0 x 1.0 space 0.5  gave 31.9%
// 1.1 x 1.1 space 0.5 offest 0.25 gave 31.6% but offset is too big (space errors)
rect_gen -width 1.1 -length 1.1 -spacing 0.5 -offset 0.0 0.0 -inside_of layer LI_fill_area -outputlayer LI_fillgen  

rule LI_fillgen { copy LI_fillgen }

//////////////////////////////////////////////////////////////////
// M1

// M1 min global density (inside seal ring):  33%
// M1 max global density (inside seal ring):  62%

// Low stepped OXIDE density:  700 um window, step 70 um:  80% MIN

// m1 "pattern density RANGE" inside seal ring --
// 	Max stepped density:  2000 um window, step 200 um:  15 % MAX

// m1 is:  OR m1:dg  m1:fill
// where routed, m1 appears mostly horizontal

// m1 fill is 0.3 x 2.0 (largest)

// m1 fill min spacing to m1_fill / mcon / m1 / via1 / m1 fill_block:  0.30
// m1 fill min spacing to m1 block:	0.14
// m1 fill min spacing to SEALID:  1.0
// m1 fill min enclosure by areaid.ft  0.50  (frameRect)

// m1_keepOut:
// NOTE: "m1" include met1:dg and met1_fill

size -by 0.30 (OR mcon m1 via1 m1_fill_block) -outputlayer m1_KO_1
size -by 0.14 m1_block -outputlayer m1_KO_2

OR KO_all_1 KO_all_2 m1_KO_1 m1_KO_2 -outputlayer m1_KO

NOT fill_area m1_KO -outputlayer m1_fill_area

rect_gen -width 0.6 -length 0.6 -spacing 0.4 -offset 0.1 0.1 -inside_of layer m1_fill_area -outputlayer m1_fillgen 

rule m1_fillgen { copy m1_fillgen }


//////////////////////////////////////////////////////////////////
// M2

// m2 min global density (inside seal ring): 33 %

// m2 fill:  0.3 x 2.0 largest

// m2 fill min spacing to m2_fill / via1 / m2 / via2 / m2 fill_block:  0.3
// m2 fill min spacing to m2 block:	0.14
// m2 fill min spacing to SEALID:  1.0
// m2 fill min enclosure by areaid.ft  0.50  (frameRect)

// Note: m2 includes m2:dg , m2:fill

size -by 0.30 (OR via1 m2 via2 m2_fill_block) -outputlayer m2_KO_1
size -by 0.14 m2_block -outputlayer m2_KO_2

OR KO_all_1 KO_all_2 m2_KO_1 m2_KO_2 -outputlayer m2_KO

NOT fill_area m2_KO -outputlayer m2_fill_area

// use slightly larger size for M2 as some designs had global values that were too small
// 0.6 x 0.6 space 0.4  gave 30%
// v04 used 0.7 x 0.7 space 0.4  gave 31.8%
rect_gen -width 0.8 -length 0.8 -spacing 0.4 -offset 0.1 0.1 -inside_of layer m2_fill_area -outputlayer m2_fillgen 

rule m2_fillgen { copy m2_fillgen }


//////////////////////////////////////////////////////////////////
// m3

// m3 fill:  0.5 x 2.0 largest

// m3 fill min spacing to m3 fill: 0.3
// m3 fill min spacing to via2 / via3 / m3 fill_block:  0.5
// m3 fill min spacing to m3 block:	0.3 
// m3 fill min spacing to SEALID:  1.0
// m3 fill min enclosure by areaid.ft  0.50  (frameRect)

// m3 min spacing to capm:  1.2 um
//   I use 1.34 because SW uses "cap bottom" which is capm size by 0.14 um

// Note: separate out m3:fill and m3:dg as the minimum spacings are different

size -by 0.50 (OR via2 m3_dg via3 m3_fill_block) -outputlayer m3_KO_1
size -by 0.3 (OR m3_fill m3_block) -outputlayer m3_KO_2
size -by 0.14 m3_block -outputlayer m3_KO_3
size -by 1.34 capm -outputlayer m3_KO_4

OR KO_all_1 KO_all_2 m3_KO_1 m3_KO_2 m3_KO_3 m3_KO_4 -outputlayer m3_KO

NOT fill_area m3_KO -outputlayer m3_fill_area

rect_gen -width 1.0 -length 1.0 -spacing 0.75 -offset 0.5 0.25 -inside_of layer m3_fill_area -outputlayer m3_fillgen 

rule m3_fillgen { copy m3_fillgen }

//////////////////////////////////////////////////////////////////
// m4

// m4 fill:  0.5 x 2.0 largest

// m4 fill min spacing to m4 fill:  0.3
// m4 fill min spacing to via3 / via4 / m4 fill_block:  0.5
// m4 fill min spacing to m4 block:	0.3 
// m4 fill min spacing to SEALID:  1.0
// m4 fill min enclosure by areaid.ft  0.50  (frameRect)

// m4 min spacing to cap2m:  1.2 um
//   I use 1.34 because SW uses "cap bottom" which is cap2m sized by 0.14 um

size -by 0.50 (OR via3 m4_dg via4 m4_fill_block) -outputlayer m4_KO_1
size -by 0.3 (OR m4_fill m4_block) -outputlayer m4_KO_2
size -by 0.14 m4_block -outputlayer m4_KO_3
size -by 1.34 cap2m -outputlayer m4_KO_4

OR KO_all_1 KO_all_2 m4_KO_1 m4_KO_2 m4_KO_3 m4_KO_4 -outputlayer m4_KO

NOT fill_area m4_KO -outputlayer m4_fill_area

// 0.5 x 1.0 spacing 1.0 gave 18%
//               X           Y                        X   Y
//rect_gen -width 0.5 -length 1.0 -spacing 0.5 -offset 0.25 0.50 -inside_of layer m4_fill_area -outputlayer m4_fillgen 
rect_gen -width 1.0 -length 1.0 -spacing 0.75 -offset 0.25 0.25 -inside_of layer m4_fill_area -outputlayer m4_fillgen 

rule m4_fillgen { copy m4_fillgen }


//////////////////////////////////////////////////////////////////
// m5

// m5 fill:  2.0 (smallest) x 5.0 (largest)

// m5 fill min spacing to m5 fill: 1.6
// m5 fill min spacing to m5 / via4 / viatop (?) / m5 fill_block:  3.0
// m5 fill min spacing to m5 block:	1.6 
// m5 fill min spacing to SEALID:  1.6
// m5 fill min enclosure by areaid.ft  1.0  (frameRect)

size -by 3.0 (OR via4 m5_dg m5_fill_block) -outputlayer m5_KO_1
size -by 1.6 SEALID -outputlayer m5_KO_2
edge_expand -inside_by 1.0 -corner_fill areaid.ft -outputlayer m5_KO_3
size -by 1.6 (OR m5_fill m5_block) -outputlayer m5_KO_4
size -by 1.6 m5_block -outputlayer m5_KO_5

OR m5_KO_1 m5_KO_2 m5_KO_3 m5_KO_4 m5_KO_5 -outputlayer m5_KO

NOT fill_area m5_KO -outputlayer m5_fill_area

//rect_gen -width 5.0 -length 4.0 -spacing 1.6 -offset 0.5 0.4 -inside_of layer m5_fill_area -outputlayer m5_fillgen 

CMACRO GEN_M5  m5_fill_area    m5_fillgen_1  5.0 5.0 m5_fill_area_2
CMACRO GEN_M5  m5_fill_area_2  m5_fillgen_2  5.0 3.5 m5_fill_area_3
CMACRO GEN_M5  m5_fill_area_3  m5_fillgen_3  3.5 5.0 m5_fill_area_4
CMACRO GEN_M5  m5_fill_area_4  m5_fillgen_4  5.0 2.0 m5_fill_area_5
CMACRO GEN_M5  m5_fill_area_5  m5_fillgen_5  2.5 2.5 m5_fill_area_6
CMACRO GEN_M5  m5_fill_area_6  m5_fillgen_6  2.0 2.0 m5_fill_area_7
CMACRO GEN_M5  m5_fill_area_7  m5_fillgen_7  2.0 2.0 m5_fill_area_8

OR m5_fillgen_1 m5_fillgen_2 m5_fillgen_3 m5_fillgen_4 m5_fillgen_5 m5_fillgen_6 m5_fillgen_7 -outputlayer m5_fillgen

rule m5_fillgen { copy m5_fillgen }


DMACRO GEN_M5  REGION  FILL  W L  NEW_REGION {
  rect_gen -width W -length L -spacing 1.6 -offset 0.1 -inside_of layer REGION -maintain_spacing -outputlayer FILL
  size -by 1.6 FILL -outputlayer KO
  NOT REGION KO -outputlayer NEW_REGION
}


//////////////////////////////////////////////////////////////////
// Output

// Use fill_CTL.pvl to control fillgen output

// For debugging, do not use fill_CTL.pvl
// Instead, uncomment out the "reults_db" line below to create ASCII output
// This can be loaded into Virtuoso like any DRC output file
// Set the DRC output limit to "ALL" to see all of the generated fill

// results_db -drc "FILL.ascii" -ascii ;

