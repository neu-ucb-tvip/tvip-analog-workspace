{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["dom", "dom.iterable", "es2020"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": false,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mdx"],
	"exclude": ["node_modules"]
} 